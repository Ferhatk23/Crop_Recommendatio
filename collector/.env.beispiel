# Vorlage für die Zugangsdaten des Sammlers.
#
#   cp .env.beispiel .env      und dann ausfüllen
#
# Die .env selbst steht in .gitignore und gehört NIEMALS ins Repository.
# Kontonummer und Passwort auch nicht in einen Chat, ein Ticket oder eine
# Fehlermeldung.

# --- MT5 -------------------------------------------------------------------

MT5_LOGIN=12345678

# WICHTIG: das INVESTOR-Passwort, nicht das Master-Passwort.
#
# Das Investor-Passwort ist nur zum Lesen da -- damit kann niemand
# handeln, auch dieses Skript nicht. Das Master-Passwort hier einzutragen
# hiesse, einem Programm Handelsrechte zu geben, das nur lesen soll. Ein
# Fehler darin könnte Positionen schliessen.
#
# Das Investor-Passwort steht in der Kontoeröffnungs-Mail von Alpha
# Capital, oder im Terminal unter Extras -> Optionen -> Server -> Ändern.
MT5_PASSWORT=

MT5_SERVER=AlphaCapital-Live02

# Pfad zum Terminal innerhalb des Wine-Präfix.
MT5_PFAD=C:\Program Files\MetaTrader 5\terminal64.exe

# --- TradeDiary ------------------------------------------------------------

# Wo die API läuft. Im Heimnetz die IP des Ubuntu-Rechners.
TRADEDIARY_URL=http://127.0.0.1:8000

# Aus: python scripts/marke.py anlegen <konto-nummer>
#
# Diese Marke darf nur einliefern, nicht lesen. Wer sie findet, kommt
# damit nicht an Notizen oder Kontostände.
TRADEDIARY_TOKEN=

# Wie oft im Dauerbetrieb abgeglichen wird. 300 = alle fünf Minuten.
# Öfter bringt nichts: Ein geschlossener Trade ist geschlossen.
SAMMLER_TAKT_SEKUNDEN=300
